# Server-only configuration. Never served to the browser.
CAD_AGENT_PROVIDER=deepseek
# DeepSeek-V4.1-Flash: https://api.deepseek.com / model deepseek-flash
# Only this credential is used when provider=deepseek.
DEEPSEEK_API_KEY=
CAD_AGENT_DATA_DIR=.data
CAD_AGENT_PORT=8765

# Optional local embedding. Prepare explicitly; no automatic model download in chat.
# python -m scripts.prepare_embedding
# CAD_EMBEDDING_MODEL_DIR=/absolute/path/to/cad_opt_agent/.data/models/bge-small-zh-v1.5
# Chat defaults to keyword; select hybrid in the UI or retrieval_mode in /api/chat-runs.

# Optional Qwen profiles. Import ONLY these fields with:
# python -m scripts.import_qwen_config /path/to/source/.env
# Browser model choices never include keys or endpoint URLs.
CAD_QWEN_LARGE_BASE_URL=
CAD_QWEN_LARGE_MODEL=
CAD_QWEN_LARGE_API_KEY=
CAD_QWEN_LARGE_CONTEXT_LENGTH=262144
CAD_QWEN_MEDIUM_BASE_URL=
CAD_QWEN_MEDIUM_MODEL=
CAD_QWEN_MEDIUM_API_KEY=
CAD_QWEN_MEDIUM_CONTEXT_LENGTH=16384
CAD_QWEN_SMALL_BASE_URL=
CAD_QWEN_SMALL_MODEL=
CAD_QWEN_SMALL_API_KEY=
CAD_QWEN_SMALL_CONTEXT_LENGTH=2048

# Internal ODA DWG conversion. Server-only key; never sent to browser/model.
CAD_ODA_BASE_URL=http://192.168.1.146:18080
CAD_ODA_API_KEY=
CAD_ODA_TIMEOUT_SECONDS=600
